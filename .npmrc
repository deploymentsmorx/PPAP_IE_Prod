# next-auth@5 (beta) declares a peer range on nodemailer@^7||^8, but we run
# nodemailer@10 for patched CVEs (nodemailer's createTransport/sendMail API
# is unchanged across those majors). Bypass the stale peer check project-wide
# rather than re-flagging --legacy-peer-deps on every install.
legacy-peer-deps=true
