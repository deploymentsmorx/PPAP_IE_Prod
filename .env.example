# PostgreSQL used by the PPAP app and Prisma CLI.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Optional direct PostgreSQL URL for Prisma migrations when DATABASE_URL is a pooler.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# NextAuth
AUTH_SECRET="replace-with-a-random-secret-e.g.-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Comma-separated email addresses allowed to bootstrap Super Admin access.
SUPER_ADMIN_EMAILS="superadmin@example.com"

# Email magic link (Maildev SMTP catcher in docker-compose; UI at http://localhost:1080)
EMAIL_SERVER="smtp://localhost:1025"
EMAIL_FROM="PPAP System <ppap@ingenious-engineering.local>"

# Bearer token an external scheduler sends to GET /api/cron/calibration-digest
# (weekly due/overdue instrument email). The route refuses to run without it.
CRON_SECRET="replace-with-a-random-secret"

# AWS S3 file storage. The app stores objects under ppap_data_prod/ in this bucket.
# Uncomment for deployment and set the actual bucket region.
# S3_BUCKET="ppap-ie-prod"
# S3_PREFIX="ppap_data_prod"
# S3_REGION="replace-with-bucket-region"

# Set S3_ENDPOINT only for an S3-compatible service; omit it for AWS S3.
# S3_ENDPOINT="https://s3.example.com"
# S3_FORCE_PATH_STYLE="true"

# Prefer an IAM role on the deployment host. If using access keys, set
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY in the host's secret store.
