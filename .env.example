# Copy to .env and adjust as needed. Defaults below match docker-compose.yml.

DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require"

# NextAuth
AUTH_SECRET="replace-with-a-random-secret-e.g.-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Email magic link (Maildev SMTP catcher in docker-compose; UI at http://localhost:1080)
EMAIL_SERVER="smtp://localhost:1025"
EMAIL_FROM="PPAP System <ppap@ingenious-engineering.local>"

# Bearer token an external scheduler sends to GET /api/cron/calibration-digest
# (weekly due/overdue instrument email). The route refuses to run without it.
CRON_SECRET="replace-with-a-random-secret"

# S3-compatible storage (MinIO in docker-compose)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="ppap_minio"
S3_SECRET_ACCESS_KEY="ppap_minio_secret"
S3_BUCKET="ppap-attachments"
S3_FORCE_PATH_STYLE="true"
